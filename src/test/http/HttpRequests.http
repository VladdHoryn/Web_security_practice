@baseUrl = http://localhost:8081

# USER      — перегляд книг, створення бронювання
@userLogin = user
@userPassword = User123!

# LIBRARIAN — те саме, що USER + додавання книг, зміна статусу, керування бронюваннями
@librarianLogin = librarian
@librarianPassword = Librarian123!

# ADMIN     — повний доступ (у т.ч. видалення книг і керування користувачами)
@adminLogin = admin
@adminPassword = Adminamdin123!

### ==========================================
### AUTH CONTROLLER — виконати першими: токени зберігаються в userToken / librarianToken / adminToken
### ==========================================

### Логін USER → JWT
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "{{userLogin}}",
  "password": "{{userPassword}}"
}

> {% client.global.set("userToken", response.body.token); %}

### Логін LIBRARIAN → JWT
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "{{librarianLogin}}",
  "password": "{{librarianPassword}}"
}

> {% client.global.set("librarianToken", response.body.token); %}

### Логін ADMIN → JWT
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "{{adminLogin}}",
  "password": "{{adminPassword}}"
}

> {% client.global.set("adminToken", response.body.token); %}

### Логін з неправильним паролем → 401
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "{{adminLogin}}",
  "password": "wrong-password"
}

### Реєстрація нового користувача (завжди роль USER) → 201 + JWT
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "new_reader",
  "password": "Reader123!"
}

### Запит без токена → 401
GET {{baseUrl}}/api/books

### Запит з недійсним токеном → 401
GET {{baseUrl}}/api/books
Authorization: Bearer invalid.jwt.token

### ==========================================
### BOOK CONTROLLER
### ==========================================

### Отримати всі книги (USER, LIBRARIAN, ADMIN)
GET {{baseUrl}}/api/books
Authorization: Bearer {{userToken}}

### Отримати лише доступні (незаброньовані) книги (USER, LIBRARIAN, ADMIN)
GET {{baseUrl}}/api/books/available
Authorization: Bearer {{userToken}}

### Знайти книгу за ID (USER, LIBRARIAN, ADMIN)
GET {{baseUrl}}/api/books/1
Authorization: Bearer {{userToken}}

### Додати нову книгу (LIBRARIAN, ADMIN)
POST {{baseUrl}}/api/books
Authorization: Bearer {{librarianToken}}
Content-Type: application/json

{
  "title": "Clean Code",
  "author": "Robert C. Martin",
  "isbn": "978-0132350884",
  "publishedYear": 2008
}

### Змінити статус бронювання книги (LIBRARIAN, ADMIN)
PATCH {{baseUrl}}/api/books/1/status?reserved=true
Authorization: Bearer {{librarianToken}}

### Видалити книгу за ID (ADMIN)
DELETE {{baseUrl}}/api/books/1
Authorization: Bearer {{adminToken}}

### ==========================================
### RESERVATION CONTROLLER
### ==========================================

### Отримати всі бронювання (LIBRARIAN, ADMIN)
GET {{baseUrl}}/api/reservations
Authorization: Bearer {{librarianToken}}

### Знайти бронювання за ID (LIBRARIAN, ADMIN)
GET {{baseUrl}}/api/reservations/1
Authorization: Bearer {{librarianToken}}

### Отримати список бронювань конкретного користувача (LIBRARIAN, ADMIN)
GET {{baseUrl}}/api/reservations/user/1
Authorization: Bearer {{librarianToken}}

### Створити нове бронювання (USER, LIBRARIAN, ADMIN)
POST {{baseUrl}}/api/reservations?bookId=1&userId=1
Authorization: Bearer {{userToken}}

### Скасувати бронювання (повернути книгу) (LIBRARIAN, ADMIN)
DELETE {{baseUrl}}/api/reservations/1
Authorization: Bearer {{librarianToken}}

### ==========================================
### USER CONTROLLER (лише ADMIN)
### ==========================================

### Отримати всіх користувачів
GET {{baseUrl}}/api/users
Authorization: Bearer {{adminToken}}

### Знайти користувача за ID
GET {{baseUrl}}/api/users/1
Authorization: Bearer {{adminToken}}

### Знайти користувача за email
GET {{baseUrl}}/api/users/search?email=test@example.com
Authorization: Bearer {{adminToken}}

### Додати нового користувача
POST {{baseUrl}}/api/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "John Doe",
  "email": "test@example.com"
}

### Оновити дані користувача (ім'я та/або email)
PUT {{baseUrl}}/api/users/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "John Doe Updated",
  "email": "updated.test@example.com"
}

### Видалити користувача за ID
DELETE {{baseUrl}}/api/users/1
Authorization: Bearer {{adminToken}}

### ==========================================
### ПЕРЕВІРКА ОБМЕЖЕНЬ (очікується 403 Forbidden)
### ==========================================

### USER намагається додати книгу → 403
POST {{baseUrl}}/api/books
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "title": "Forbidden Book",
  "author": "Nobody",
  "isbn": "978-0000000000",
  "publishedYear": 2020
}

### LIBRARIAN намагається видалити книгу → 403
DELETE {{baseUrl}}/api/books/1
Authorization: Bearer {{librarianToken}}

### LIBRARIAN намагається переглянути користувачів → 403
GET {{baseUrl}}/api/users
Authorization: Bearer {{librarianToken}}
